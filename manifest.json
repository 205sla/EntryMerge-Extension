{
  "manifest_version": 3,
  "name": "EntryMerge - 엔트리 작품 합치기",
  "version": "1.0.1",
  "description": "엔트리(Entry) 작품 파일(.ent)을 합쳐주는 도구",
  "action": {
    "default_title": "EntryMerge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
